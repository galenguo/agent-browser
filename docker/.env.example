# ========== LLM API 配置 ==========
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4

# ========== 部署模式 ==========
# all-in-one: API + 浏览器在同一容器（推荐用于单用户/开发）
# distributed: API 容器 + 独立浏览器容器（未来扩展，用于多用户生产）
DEPLOYMENT_MODE=all-in-one

# ========== 浏览器模式 ==========
# local: 容器内本地浏览器（all-in-one 模式）
# docker: 独立浏览器容器（distributed 模式）
BROWSER_MODE=local

# ========== 会话配置 ==========
MAX_SESSIONS=10                # 最大并发会话数
IDLE_TIMEOUT_SECONDS=1800      # 会话空闲超时（秒）

# ========== 浏览器配置 ==========
CDP_PORT=19222
HEADLESS=false
DISPLAY=:99

# ========== 数据目录 ==========
PROFILE_STORAGE=/data/profiles
# Distributed 模式必须设置：宿主机上 profile 目录的绝对路径
# 用于 API 容器将 profile 目录挂载到浏览器容器
# HOST_PROFILE_PATH=/absolute/path/to/docker/data/profiles

# ========== 日志配置 ==========
LOG_LEVEL=info

# ========== 调试配置 ==========
# 设为 true 时崩溃的浏览器容器不会自动删除，方便查看日志
DEBUG_CONTAINERS=false
