ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here

# CloakBrowser 二进制路径
CLOAKBROWSER_PATH=/opt/cloakbrowser/chrome

# CDP 监听端口（非标准，避免探测）
CDP_PORT=19222

# 是否无头模式（Docker 中设 false，通过 Xvfb 运行）
HEADLESS=false

# 代理（可选）格式: http://user:pass@host:port
# PROXY_URL=http://user:pass@residential-proxy:port

# Profile 存储目录
PROFILE_STORAGE=/data/profiles

# ─── 分布式部署：浏览器节点公网地址配置 ───
# 设置后，创建 Session 时响应中将返回 browser_node（含 noVNC 监控 URL）
# 腾讯云 VPC 场景：宿主机公网 IP 或已备案域名
# BROWSER_PUBLIC_HOST=1.2.3.4
# 端口偏移量（默认 0，即 VPC 端口透传）
# 若 VPC DNAT 做了偏移（如宿主机 6080 → 公网 16080），则填 10000
# BROWSER_PORT_OFFSET=0
