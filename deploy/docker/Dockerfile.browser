FROM registry-cn-gimc-local.gimccloud.com/docker.io/library/python:3.11-slim

# 使用阿里云 Debian 镜像源（国内网络加速）
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || \
    sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list 2>/dev/null || true

# 系统基础依赖（浏览器运行环境）
RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb \
    x11vnc \
    novnc \
    websockify \
    libnss3 \
    libxss1 \
    libx11-xcb1 \
    libatk-bridge2.0-0 \
    libgtk-3-0 \
    libdrm2 \
    libgbm1 \
    libxshmfence1 \
    libxrandr2 \
    libpangocairo-1.0-0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxkbcommon0 \
    libasound2-dev \
    fonts-wqy-zenhei \
    fonts-liberation \
    fonts-dejavu-core \
    fonts-freefont-ttf \
    curl \
    procps \
    gcc \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# 中文字体
RUN apt-get update && apt-get install -y --no-install-recommends \
    fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 安装 Python 依赖（只需要浏览器相关的）
COPY requirements.txt .
RUN pip install --upgrade pip setuptools wheel && \
    pip install --no-cache-dir --timeout 120 --retries 5 \
    cloakbrowser==0.3.21 \
    patchright \
    rebrowser-playwright \
    browserforge \
	aiohttp \
    pyyaml \
    fastapi \
    uvicorn[standard]

# 预下载 CloakBrowser 二进制（必须成功，否则运行时会超时）
# 重试 3 次，每次超时 300s
RUN for i in 1 2 3; do \
        python -c "import cloakbrowser; cloakbrowser.ensure_binary()" && break || \
        (echo "CloakBrowser download attempt $i failed, retrying..." && sleep 10); \
    done && \
    python -c "import cloakbrowser; print('CloakBrowser binary:', cloakbrowser.ensure_binary())"

# 清理编译依赖（节省约 200MB）
RUN apt-get purge -y gcc python3-dev && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/* /tmp/* /root/.cache/pip

# 复制源码和启动脚本
COPY stealth_browser/ /app/src/stealth_browser/
COPY deploy/docker/entrypoint-browser.sh /entrypoint-browser.sh
RUN chmod +x /entrypoint-browser.sh

# 数据目录
RUN mkdir -p /data/profiles

# 环境变量
ENV DISPLAY=:99 \
    CDP_PORT=19222 \
    CDP_BIND_ADDRESS=0.0.0.0 \
    HEADLESS=false \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    REBROWSER_PATCHES_RUNTIME_FIX_MODE=addBinding \
    TZ=Asia/Shanghai \
    LANG=zh_CN.UTF-8 \
    LANGUAGE=zh_CN:zh \
    LC_ALL=zh_CN.UTF-8

EXPOSE 80 19222 6080 5900

ENTRYPOINT ["/entrypoint-browser.sh"]
